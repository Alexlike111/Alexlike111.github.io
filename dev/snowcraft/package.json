{
  "name": "snowcraft",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test:sim": "tsx tests/sim.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "build:pg": "tsc --noEmit && vite build --mode pg && node scripts/pg-pack.mjs",
    "pack:pg": "node scripts/pg-pack.mjs"
  },
  "devDependencies": {
    "@playgama/bridge": "^2.4.1",
    "tsx": "^4.20.0",
    "typescript": "5.9",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@fontsource/jura": "^5.2.0",
    "@fontsource/pixelify-sans": "^5.2.0"
  }
}
