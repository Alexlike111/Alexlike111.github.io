{
  "name": "smash-circuit",
  "private": true,
  "version": "0.1.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-release.mjs --src",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:player": "node e2e/player-checks.mjs",
    "e2e:platform": "node e2e/platform.mjs",
    "check-release": "node scripts/check-release.mjs",
    "check-release:strict": "node scripts/check-release.mjs --strict",
    "release": "npm run typecheck && npm test && npm run build && npm run e2e:player && npm run e2e:platform && npm run check-release",
    "deploy": "npm run release && rm -rf ../../play-test/smash && cp -r dist ../../play-test/smash"
  },
  "dependencies": {
    "@playgama/bridge": "^2.4.0",
    "planck": "^1.4.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
